# ── account-service ──────────────────────────────────────────────────────────
# Copy to `.env`. Loaded after the root .env; values here override shared defaults
# for this service only.

# This service owns account_db.
DB_URL=jdbc:postgresql://localhost:5432/account_db
SERVER_PORT=8081
GRPC_SERVER_PORT=9081

# AWS_ENDPOINT / AWS_REGION are inherited from the root .env.
