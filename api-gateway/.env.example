# ── api-gateway ──────────────────────────────────────────────────────────────
# Copy to `.env`. Every value below has a sensible localhost default in
# application.yaml; override here only when it differs (e.g. federating auth to a
# licensee IdP, or pointing routes at non-default hosts). The gateway has no database.

SERVER_PORT=8080

# FEDERATION POINT: the trusted issuer's JWKS the gateway validates tokens against.
# Defaults to the bundled iam-service; point at the licensee's IdP to federate.
AUTH_ISSUER_JWKS_URL=http://localhost:8092/api/v1/.well-known/jwks.json

# Claim-name mapping for the injected identity headers (override for external IdPs
# whose claims are named differently).
GATEWAY_PROGRAM_CLAIM=program_id
GATEWAY_SCOPE_CLAIM=scope

# Downstream service locations (defaults shown; override per environment).
IAM_SERVICE_URI=http://localhost:8092
ACCOUNT_SERVICE_URI=http://localhost:8081
LEDGER_SERVICE_URI=http://localhost:8082
TRANSACTION_SERVICE_URI=http://localhost:8083
TRANSFER_SERVICE_URI=http://localhost:8084
HOLD_SERVICE_URI=http://localhost:8085
FX_SERVICE_URI=http://localhost:8086
SCHEDULER_SERVICE_URI=http://localhost:8087
AUDIT_SERVICE_URI=http://localhost:8088
WEBHOOK_SERVICE_URI=http://localhost:8090
REPORTING_SERVICE_URI=http://localhost:8091
