# ── iam-service ──────────────────────────────────────────────────────────────
# Copy to `.env`. Loaded after the root .env; values here override shared defaults
# for this service only.

# This service owns identity_db.
DB_URL=jdbc:postgresql://localhost:5432/identity_db
SERVER_PORT=8092
GRPC_SERVER_PORT=9082

# Issuer (iss) stamped on tokens — this service's externally reachable base URL.
JWT_ISSUER=http://localhost:8092
JWT_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800

# RS256 keys — leave blank in dev (an ephemeral RSA keypair is generated at startup).
# In staging/prod set PKCS#8 PEM strings (or mount files and reference them).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
