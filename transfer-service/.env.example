# ── transfer-service ─────────────────────────────────────────────────────────
# Copy to `.env`. Loaded after the root .env; values here override shared defaults
# for this service only.

# This service owns transfer_db.
DB_URL=jdbc:postgresql://localhost:5432/transfer_db
SERVER_PORT=8084
GRPC_SERVER_PORT=9084

# Internal gRPC dependencies (ADR-0010). Defaults target localhost for bootRun; in Docker
# these are set to the compose DNS names.
PARTY_GRPC_ADDRESS=static://localhost:9093
ACCOUNT_GRPC_ADDRESS=static://localhost:9081
LEDGER_GRPC_ADDRESS=static://localhost:9082
