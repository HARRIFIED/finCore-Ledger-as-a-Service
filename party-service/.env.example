# ── party-service ────────────────────────────────────────────────────────────
# Copy to `.env`. Loaded after the root .env; overrides shared defaults for this
# service only. This service owns party_db (the Customer/Party master / CIF).

DB_URL=jdbc:postgresql://localhost:5432/party_db
SERVER_PORT=8093
GRPC_SERVER_PORT=9093
