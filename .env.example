# ── finCore shared environment (root) ────────────────────────────────────────
# Copy to `.env`. These are SHARED-infra defaults, loaded by every service's
# bootRun FIRST; each service's own .env (see <service>/.env.example) is loaded
# AFTER and overrides any service-specific value. Keep only truly shared keys here.
#
# Do NOT put service-specific DB_URL here — each service owns its own database.

# Shared Postgres credentials (the per-service database NAME lives in each service's .env)
DB_USERNAME=finCore
DB_PASSWORD=finCore_secret

# Shared infrastructure
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ZIPKIN_BASE_URL=http://localhost:9411
TRACING_SAMPLE_RATE=1.0

# LocalStack (AWS emulation) — used by services that touch AWS
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
